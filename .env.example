# Copy this file to .env and fill in real values.
# Used by docker-compose (env_file: .env) for the backend service.

# --- OpenAI Realtime (voice conversation + summarization) ---
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-realtime-1.5
OPENAI_VOICE=coral

# --- Anam.ai (talking-avatar rendering) ---
ANAM_API_KEY=your-anam-api-key
ANAM_PERSONA_ID=your-anam-persona-id
ANAM_AVATAR_ID=your-anam-avatar-id
ANAM_VOICE_ID=your-anam-voice-id

# --- Simli (legacy/optional avatar pipeline, currently unused by Anam flow) ---
SIMLI_API_KEY=your-simli-api-key
SIMLI_FACE_ID=your-simli-face-id
SIMLI_MODEL=turbo
SIMLI_MAX_SESSION=600
SIMLI_MAX_IDLE=60

# --- Realtime audio tuning ---
# eagerness: auto | low | medium | high
SEMANTIC_VAD_EAGERNESS=auto
# near_field (headset) | far_field (laptop/room mic)
NOISE_REDUCTION_TYPE=far_field
AUDIO_SAMPLE_RATE=24000

# --- Backend server ---
BACKEND_PORT=8000
CORS_ORIGINS=*

# --- App login (simple shared credentials, gate the demo) ---
APP_USERNAME=changeme
APP_PASSWORD=changeme
# Random secret used to sign session tokens — set a long random string before deploying
JWT_SECRET=change-me-before-deploy
